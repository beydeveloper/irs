<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Irsafe.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Irsafe - Text Steganography Tool" 
Height="600" 
Width="800">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header with Logo -->
        <StackPanel Grid.Row="0" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,0,0,20">
            <Image Source="irs.png" 
                   Width="40" 
                   Height="40" 
                   Margin="0,0,10,0"
                   VerticalAlignment="Center"/>
            <TextBlock Text="Irsafe - Text Steganography Tool" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center"/>
        </StackPanel>
        
        <GroupBox Grid.Row="1" Header="Image File" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Grid.Column="0" 
                         x:Name="ImagePathTextBox" 
                         IsReadOnly="True" 
                         Margin="0,0,10,0" 
                         VerticalAlignment="Center"/>
                
                <Button Grid.Column="1" 
                        x:Name="BrowseImageButton" 
                        Content="Browse..." 
                        Width="80" 
                        Click="BrowseImageButton_Click"/>
            </Grid>
        </GroupBox>
        
        <GroupBox Grid.Row="2" Header="Text Content" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBox Grid.Row="0" 
                         x:Name="TextInputBox" 
                         AcceptsReturn="True" 
                         TextWrapping="Wrap" 
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Margin="0,0,0,10"/>
                
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="LoadTextButton" 
                            Content="Load Text File" 
                            Width="100" 
                            Margin="0,0,10,0" 
                            Click="LoadTextButton_Click"/>
                    
                    <Button x:Name="SaveTextButton" 
                            Content="Save Text File" 
                            Width="100" 
                            Click="SaveTextButton_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>
        
        <GroupBox Grid.Row="3" Header="Actions" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="10">
                
                <Button x:Name="HideTextButton" 
                        Content="Hide Text in Image" 
                        Width="150" 
                        Height="35" 
                        Margin="0,0,10,0" 
                        Click="HideTextButton_Click"
                        Background="LightGreen"/>
                
                <Button x:Name="ExtractTextButton" 
                        Content="Extract Text from Image" 
                        Width="150" 
                        Height="35" 
                        Click="ExtractTextButton_Click"
                        Background="LightBlue"/>
            </StackPanel>
        </GroupBox>
        
        <Border Grid.Row="4" 
                BorderBrush="Gray" 
                BorderThickness="1" 
                Background="LightGray" 
                Padding="5">
            <TextBlock x:Name="StatusTextBlock" 
                       Text="Irsafe - Ready for text steganography" 
                       FontStyle="Italic"/>
        </Border>
    </Grid>
</Window>
