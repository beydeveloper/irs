<Window x:Class="Irsafe.AssemblyEditorWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Irsafe - Assembly Code Editor" Height="500" Width="700"
WindowStartupLocation="CenterScreen"
Icon="irs.ico">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Assembly Code Editor" FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>
        
        <!-- Configuration -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Execution Type:" Width="100" VerticalAlignment="Center"/>
                <ComboBox x:Name="ExecutionTypeComboBox" Width="150">
                    <ComboBoxItem Content="Batch (.bat)" IsSelected="True" Tag="bat"/>
                    <ComboBoxItem Content="PowerShell (.ps1)" Tag="ps1"/>
                    <ComboBoxItem Content="VBScript (.vbs)" Tag="vbs"/>
                </ComboBox>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Description:" Width="100" VerticalAlignment="Center"/>
                <TextBox x:Name="DescriptionTextBox" Width="300" Text="Enhanced animation assembly code"/>
            </StackPanel>
            
            <CheckBox x:Name="AutoExecuteCheckBox" Content="Auto Execute on Image Open" Margin="100,5,0,0"/>
        </StackPanel>
        
        <!-- Code Editor -->
        <GroupBox Grid.Row="2" Header="Assembly Code">
            <TextBox x:Name="AssemblyCodeTextBox" 
                     AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Text="@echo off&#x0A;title İrsafe Animation Demo&#x0A;color 0A&#x0A;&#x0A;echo ╔════════════════════════════════════════╗&#x0A;echo ║        İrsafe Animation Demo           ║&#x0A;echo ╚════════════════════════════════════════╝&#x0A;echo.&#x0A;&#x0A;for /L %%i in (1,1,10) do (&#x0A;    cls&#x0A;    echo Loading... %%i/10&#x0A;    timeout /t 1 /nobreak >nul&#x0A;)&#x0A;&#x0A;echo.&#x0A;echo ★ İrsafe Animation Complete! ★&#x0A;pause"/>
        </GroupBox>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="CreateButton" Content="Create Payload" Width="120" Height="35" 
                    Margin="5" Click="CreateButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="35" 
                    Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>